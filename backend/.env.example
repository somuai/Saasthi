# 🔴 REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Must be "false" in production
DJANGO_DEBUG=true

# Comma-separated domain names
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# sqlite for dev, postgres for prod
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:pass@host:5432/shaasthi
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
REDIS_CACHE_MAX_CONNECTIONS=50

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_BROKER_POOL_LIMIT=20
CELERY_BROKER_CONNECTION_TIMEOUT=5

CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Comma-separated origins allowed for unsafe CSRF methods (set in prod)
CSRF_TRUSTED_ORIGINS=

# Randomised admin URL slug (defaults to "admin" if not set)
ADMIN_URL_SLUG=admin

# ── Throttling ──────────
THROTTLE_OTP=5/min
THROTTLE_SYNC_PUSH=60/min
THROTTLE_SYNC_PULL=10/min
THROTTLE_SURVEY_WRITE=10/min
THROTTLE_RISK_ASSESS=30/min
THROTTLE_GEMMA_QUERY=10/min
THROTTLE_VISIT_RECORDS=30/min
THROTTLE_FOLLOWUPS=30/min
THROTTLE_USER_MANAGEMENT=30/min
THROTTLE_WORKER_REGISTRATION=10/min
THROTTLE_REGISTRY_WRITE=30/min
THROTTLE_FLAGGING=30/min
THROTTLE_REFERRALS=30/min
THROTTLE_INCENTIVES=10/min
THROTTLE_ANALYTICS=20/min
THROTTLE_NOTIFICATIONS=30/min
THROTTLE_MCP_WRITE=30/min
THROTTLE_RISK_RULES=10/min

# ── OTP ─────────────────
OTP_TTL_MINUTES=10
EXPOSE_DEBUG_OTP=true

# ── GPS ─────────────────
GPS_ACCEPTABLE_RADIUS_M=200
GPS_WARNING_RADIUS_M=500

# ── Sentry (set DSN to enable; auto-enabled only when DEBUG=false) ──
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Release version (must match app version for source map correlation)
APP_VERSION=0.1.0

# ── Celery task time limits (seconds) ──
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
CELERY_RESULT_EXPIRES=86400
CELERY_TASK_ALWAYS_EAGER=false

# ── HTTPS / Security (only applied in prod) ──
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# ── Gemma / AI risk assessment ──
GEMMA_API_KEY=
GOOGLE_API_KEY=

# ── SMS Provider (fallback for web/supervisor OTP) ──
# Primary is Firebase Phone Auth (mobile).
# log    → OTP printed to server logs (fine for clinic web users)
# msg91  → real SMS via MSG91 (needs SMS_API_KEY + DLT template)
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=SHASTH
SMS_TEMPLATE_ID=

# ── Firebase Admin SDK (for Auth + FCM) ──
# Either set FIREBASE_SERVICE_ACCOUNT_JSON (raw JSON string) or
# FIREBASE_SERVICE_ACCOUNT_PATH (path to JSON file)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PNV_ENABLED=false
# Local/dev only. Accepts test:<phone> tokens when DJANGO_DEBUG=true.
FIREBASE_PNV_ACCEPT_TEST_TOKENS=false

# ── Mobile app version control ──
APP_MIN_VERSION=0.1.0
APP_CURRENT_VERSION=0.1.0
APP_UPDATE_URL=
APP_FORCE_UPDATE=false

# ── App version for health check ──
APP_VERSION=0.1.0
