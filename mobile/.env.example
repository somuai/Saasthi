EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
EXPO_PUBLIC_ENV=development
# Firebase config is handled via google-services.json (Android) / GoogleService-Info.plist (iOS)
# Sentry error tracking — set to your project DSN (https://sentry.io)
EXPO_PUBLIC_SENTRY_DSN=
# Sentry source map upload (set these as EAS secrets for production builds)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
