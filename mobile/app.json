{
  "expo": {
    "name": "Shaasthi Pilot",
    "slug": "shaasthi-pilot",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "shaasthi",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "splash": {
      "image": "./assets/shaasthi-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F766E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.shaasthi.pilot",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Shaasthi uses your location to record field visit data for maternal and child health tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Shaasthi needs background location access to continue tracking visits even when the app is in the background.",
        "NSPhotoLibraryUsageDescription": "Shaasthi can access your photo library to attach images to survey records.",
        "NSCameraUsageDescription": "Shaasthi uses the camera to capture wound/rash photos for health assessments."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "enactus.Shaasthi.kiit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      ["expo-build-properties", {
        "ios": {
          "usesNonExemptEncryption": false
        }
      }],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Shaasthi needs background location to track field visits.",
          "locationWhenInUsePermission": "Shaasthi uses your location to record field visit data."
        }
      ],
      [
        "expo-background-fetch",
        {
          "minimumInterval": 900
        }
      ],
      "./plugins/withWatermelonSimdjson.js",
      "./plugins/withExpoDevMenuSimulatorFix.js",
      "./plugins/withAndroidLocalProperties.js",
      "./plugins/withKotlinInPackageFix.js",
      "./plugins/withAndroidFlipperNoop.js",
      "./plugins/withEasClientCompatFix.js",
      ["sentry-expo", {
        "organization": process.env.SENTRY_ORG || "shaasthi",
        "project": process.env.SENTRY_PROJECT || "shaasthi-mobile"
      }]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "updates": {
      "url": "https://u.expo.dev/74497fca-f87f-42e1-bc20-f92362e558da",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000
    },
    "extra": {
      "apiBaseUrl": "http://192.168.29.70:8000/api/v1",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "74497fca-f87f-42e1-bc20-f92362e558da"
      }
    },
    "owner": "luciferai04lol"
  }
}
