{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "bundleIdentifier": "in.shaasthi.pilot"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development"
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "bundleIdentifier": "in.shaasthi.pilot"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-device": {
      "extends": "preview",
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "bundleIdentifier": "in.shaasthi.pilot",
        "enterpriseProvisioning": "universal"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
