{
  "name": "shaasthi-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "node scripts/setup-android-dev-connection.js && REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo start --dev-client --localhost",
    "android:reload": "node scripts/launch-android-dev-client.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:ios": "expo run:ios",
    "native:android": "node scripts/write-android-local-properties.js && node scripts/patch-android-kotlin-package.js && node scripts/patch-android-flipper.js && node scripts/ensure-android-emulator.js && node scripts/setup-android-dev-connection.js && REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:android",
    "native:android:build": "node scripts/write-android-local-properties.js && node scripts/patch-android-kotlin-package.js && node scripts/patch-android-flipper.js && node scripts/setup-android-dev-connection.js && REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:android --no-install",
    "native:android:apk": "node scripts/write-android-local-properties.js && node scripts/patch-android-kotlin-package.js && node scripts/patch-android-flipper.js && cd android && ./gradlew :app:assembleDebug",
    "web": "expo start --web",
    "test": "jest --watchAll=false",
    "verify": "npm test && cd .. && make eval-offline",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/patch-expo-dev-menu.js && node scripts/patch-ios-native-compat.js && node scripts/patch-android-kotlin-package.js && node scripts/patch-android-flipper.js && node scripts/patch-expo-modules-core.js && node scripts/patch-expo-updates.js && node scripts/patch-ajv.js",
    "eas:build:dev:ios": "eas build --profile development --platform ios",
    "eas:build:dev:android": "eas build --profile development --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.2.3",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@expo-google-fonts/noto-sans-devanagari": "^0.2.3",
    "@expo/config-plugins": "~7.9.0",
    "@expo/vector-icons": "^14.0.0",
    "@nozbe/simdjson": "^3.9.4",
    "@nozbe/watermelondb": "^0.27.1",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-community/netinfo": "11.1.0",
    "@react-native-firebase/app": "^18.9.0",
    "@react-native-firebase/auth": "^18.9.0",
    "@react-native-firebase/messaging": "^18.9.0",
    "@react-native-voice/voice": "^3.2.4",
    "@reduxjs/toolkit": "^2.2.1",
    "@shopify/flash-list": "^2.3.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-react-native": "^1.0.0",
    "@types/react": "~18.2.45",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.6.8",
    "date-fns": "^3.6.0",
    "expo": "~50.0.21",
    "expo-application": "~5.8.4",
    "expo-background-fetch": "~11.8.1",
    "expo-build-properties": "~0.11.1",
    "expo-camera": "~14.0.0",
    "expo-constants": "~15.4.6",
    "expo-dev-client": "~3.3.12",
    "expo-device": "~5.9.4",
    "expo-file-system": "~16.0.9",
    "expo-font": "~11.10.3",
    "expo-gl": "~13.6.0",
    "expo-linking": "~6.2.2",
    "expo-location": "~16.5.5",
    "expo-router": "~3.4.10",
    "expo-secure-store": "~12.8.1",
    "expo-sharing": "~11.10.0",
    "expo-sqlite": "~13.4.0",
    "expo-status-bar": "~1.11.1",
    "expo-system-ui": "~2.9.4",
    "expo-task-manager": "~11.7.3",
    "expo-updates": "~0.24.13",
    "i18next": "^26.3.0",
    "lottie-react-native": "6.5.1",
    "moti": "^0.30.0",
    "prop-types": "^15.8.1",
    "react": "18.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.73.6",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-native-webview": "^13.16.1",
    "react-redux": "^9.1.0",
    "sentry-expo": "^7.2.0",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "ajv": "^8.20.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "expo-application": "~5.8.4",
    "expo-device": "~5.9.4",
    "jest": "^29.7.0",
    "jest-expo": "~50.0.4",
    "prettier": "^3.8.3"
  },
  "overrides": {
    "@react-native-voice/voice": {
      "@expo/config-plugins": "~7.9.0"
    }
  }
}
