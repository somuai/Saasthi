# SHAASTHI monorepo

.DS_Store
.env
.env.*
!.env.example

# Node / Expo
node_modules/
.expo/
mobile/ios/
mobile/android/
.cursor/
dist/
web-build/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python / Django
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
db.sqlite3
media/
staticfiles/

# Model artifacts
*.pkl
*.joblib
models/*.json

# Firebase
mobile/google-services.json
mobile/GoogleService-Info.plist
firebase-service-account.json

# Local runtime
tmp/
logs/

# Xcode / CocoaPods
mobile/ios/Pods/
*.xcworkspace
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/

# EAS / build artifacts
mobile/.easignore
*.ipa
*.apk
*.aab

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
.gemini/

# Key stores / signing (never commit)
*.keystore
*.pem
*.key
*.p12
