{
  "name": "medilift-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "node scripts/setup-android-dev-connection.js && REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo start --dev-client --localhost",
    "android:reload": "node scripts/launch-android-dev-client.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:ios": "expo run:ios",
    "native:android": "node scripts/write-android-local-properties.js && node scripts/patch-android-kotlin-package.js && node scripts/ensure-android-emulator.js && node scripts/setup-android-dev-connection.js && REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:android",
    "native:android:build": "node scripts/write-android-local-properties.js && node scripts/patch-android-kotlin-package.js && node scripts/setup-android-dev-connection.js && REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:android --no-install",
    "native:android:apk": "node scripts/write-android-local-properties.js && cd android && ./gradlew :app:assembleDebug",
    "web": "expo start --web",
    "test": "jest --watchAll=false",
    "verify": "npm test && cd .. && make eval-offline",
    "postinstall": "node scripts/patch-expo-dev-menu.js && node scripts/patch-android-kotlin-package.js",
    "eas:build:dev:ios": "eas build --profile development --platform ios",
    "eas:build:dev:android": "eas build --profile development --platform android"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.2.3",
    "@expo-google-fonts/noto-sans-devanagari": "^0.2.3",
    "@expo/vector-icons": "^14.0.0",
    "@nozbe/watermelondb": "^0.27.1",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@react-native-community/netinfo": "11.1.0",
    "@reduxjs/toolkit": "^2.2.1",
    "axios": "^1.6.8",
    "date-fns": "^3.6.0",
    "expo": "~50.0.21",
    "expo-background-fetch": "~11.8.1",
    "expo-constants": "~15.4.6",
    "expo-dev-client": "~3.3.12",
    "expo-font": "~11.10.3",
    "expo-linking": "~6.2.2",
    "expo-location": "~16.5.5",
    "expo-router": "~3.4.10",
    "expo-secure-store": "~12.8.1",
    "expo-sqlite": "~13.4.0",
    "expo-status-bar": "~1.11.1",
    "expo-system-ui": "~2.9.4",
    "expo-task-manager": "~11.7.3",
    "prop-types": "^15.8.1",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-svg": "14.1.0",
    "react-redux": "^9.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "jest": "^29.7.0",
    "jest-expo": "~50.0.4"
  }
}
