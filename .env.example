# ── SHAASTHI Production Environment Template ─────────────────
# Copy to .env for local dev, or use as reference for production.

# ── Mobile App (shaasthi-app/.env) ───────────────────────────
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# ── Django API (shaasthi-api/.env) ───────────────────────────

# 🔴 REQUIRED — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production

# Must be "false" in production
DJANGO_DEBUG=true

# Comma-separated; must list your production domain(s) in prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: SQLite for dev, PostgreSQL for prod
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://shaasthi:shaasthi@localhost:5432/shaasthi

# Redis (required for Celery + rate limiting)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS — the mobile app origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Rate limits
THROTTLE_OTP=5/min
THROTTLE_SYNC_PUSH=60/min

# ═════════════════════════════════════════════════════════════
# Production-only settings (leave empty for dev)
# ═════════════════════════════════════════════════════════════

# Sentry error tracking (https://sentry.io)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# OTP delivery via Firebase Auth (no extra config needed)

# Firebase Admin SDK — full service account JSON string (not file path).
# Download from Firebase Console → Project Settings → Service Accounts → Generate private key.
# Paste the entire JSON on a single line (or use your shell's export with the literal JSON).
# Example: export FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google AI / Gemma 4 API key
GEMMA_API_KEY=

# App version enforcement (semver, e.g. "1.0.0")
APP_MIN_VERSION=0.1.0
APP_CURRENT_VERSION=0.1.0
APP_UPDATE_URL=
APP_FORCE_UPDATE=false
