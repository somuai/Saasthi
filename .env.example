# ── Django / Backend ──────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-unique-random-key

# Must be "false" in production
DEBUG=False

# Comma-separated — set to your actual domain(s)
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Django uses this; docker-compose builds POSTGRES_* vars below
DATABASE_URL=postgres://saasthi:saasthi_dev_password@postgres:5432/saasthi

# Redis (used by Celery + caching)
REDIS_URL=redis://redis:6379/0

# API port mapping
API_PORT=8000

# ── PostgreSQL (docker-compose only) ───────────────────────
POSTGRES_DB=saasthi
POSTGRES_USER=saasthi
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ── Sentry (optional — leave blank to disable) ────────────
SENTRY_DSN=
# SENTRY_DSN=https://d4f8131f8419e7a7fb0b82267564a34a@o4511429890211840.ingest.de.sentry.io/4511429933596752

# ── Gemma / AI risk assessment ────────────────────────────
GEMMA_API_KEY=

# ── Nginx ─────────────────────────────────────────────────
NGINX_PORT=80
