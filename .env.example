# MEDILIFT — environment template (copy to .env and adjust)

# Expo / React Native (medilift-app)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Django API (medilift-api) — Prompt 10 layout
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://medilift:medilift@localhost:5432/medilift

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional: Sentry
# SENTRY_DSN=

# OTP SMS (production): MSG91 / Twilio keys
# SMS_PROVIDER_API_KEY=
